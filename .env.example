MINIO_ROOT_USER=potreeadmin
MINIO_ROOT_PASSWORD=s3Almacenamiento

# Tamano maximo de archivo LAS/LAZ aceptado, en GB
MAX_UPLOAD_GB=200

# Postgres administrado por Supabase. Copialo desde
# Project Settings > Database > Connection string (modo "Session pooler" o
# directo) en el dashboard de Supabase. El password debe ir URL-encoded.
# se debe agregar la conexion string de POOLER para que funcione con la app de potree, ya que la app hace muchas conexiones a la base de datos y el pooler es necesario para manejar eso.
DATABASE_URL=postgresql://postgres:PASSWORD_URL_ENCODED@db.xxxxxxxx.supabase.co:5432/postgres

# URL del proyecto de Supabase (Project Settings > API > Project URL). La API
# la usa para validar, via el JWKS publico del proyecto, los tokens que emite
# Supabase Auth en el login.
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Origen(es) permitidos por CORS, separados por coma.
FRONTEND_URL=http://localhost:8080

# URL publica de la API (Cloudflare Tunnel). Se usa para convertir en
# absolutas las URLs prefirmadas de subida a MinIO, necesario cuando el
# frontend vive en otro origen (ej. Cloudflare Pages). Vacio en local, donde
# frontend y API comparten origen via el nginx del docker-compose.
BACKEND_PUBLIC_URL=

# Token del Cloudflare Tunnel (Zero Trust > Networks > Tunnels > tu tunnel >
# instalar con Docker). Expone la API de la NAS a internet via
# nas.tudominio.com sin abrir puertos en el router.
CLOUDFLARE_TUNNEL_TOKEN=
